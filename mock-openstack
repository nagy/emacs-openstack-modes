#!/usr/bin/env bash
# Fake `openstack` client for demoing/testing without a real cloud.
# Emits canned JSON in the exact shape python-openstackclient prints
# with --format json.  Set `openstack-program' to this file's path.

# Strip trailing "--format json" that openstack-cli appends.
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --format) shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
cmd="${args[*]}"

die() {
    echo "openstack: $1 (NotFound): $2 not found (HTTP 404)" >&2
    exit 1
}

